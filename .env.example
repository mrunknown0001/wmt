APP_NAME=WMT
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Firebase Cloud Messaging (for mobile push notifications)
# Place your service account JSON at storage/app/firebase-credentials.json
# Or set a custom path: FCM_CREDENTIALS=/path/to/credentials.json
FCM_PROJECT_ID=

# AI Platform: "openai" or "openrouter"
AI_PLATFORM=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o

FCM_PROJECT_ID=your-firebase-project-id

TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key

# Database Backup
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=admin@wmt.com

# Google Drive (for off-site backups)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_PATH=Backup/WMT
# Per-purpose AI models (auto-routed). Leave blank to fall back to AI_MODEL_CHAT
# (which itself falls back to OPENROUTER_MODEL). Use vision/multimodal models for
# AI_MODEL_VISION so image & PDF attachments can be read.
AI_MODEL_CHAT=
AI_MODEL_VISION=openai/gpt-4o
AI_MODEL_REASONING=
AI_MODEL_DOCUMENTS=

# Inbound notification webhook: callers send this in the x-api-key header.
# Leave blank to disable POST /api/webhooks/notify entirely.
WEBHOOK_API_KEY=
