# Production environment template.
#
# Mirrors the shape of the live production .env so the settings that are only
# ever set on that host — log rotation and level, email off, queue and cache
# drivers — are recorded somewhere other than the host itself. Rebuilding the
# box from .env.example alone would silently lose them.
#
#   cp .env.production.example .env    # then fill in every REPLACE_ME
#
# Every credential is REPLACE_ME. Generated with a deny-by-default rule: a key is
# redacted unless it is explicitly known to be non-secret, so a new variable
# added later is redacted by default rather than leaked because nobody
# remembered to classify it. Never commit a filled-in copy of this file.
#
# APP_KEY: generate with `php artisan key:generate --show`, and note that
# changing it on a running system invalidates existing sessions and any
# encrypted column.

APP_NAME=WMT
# Production, not local. The live host currently says local; nothing in this
# application branches on it, but it is what the environment is.
APP_ENV=production
APP_KEY=REPLACE_ME
# Off. With it on, a JSON 5xx returns the exception class and message to the
# caller — an SQL error names tables and columns, a file error names paths.
# The HTML error page and the {message, reference} body are unaffected.
APP_DEBUG=false
APP_URL=https://wmt.bfcgroup.ph

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Rotation: daily writes laravel-YYYY-MM-DD.log and prunes past LOG_DAILY_DAYS.
# single wrote one file that grew forever and aged nothing out.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# Warnings and above. Drops the INFO chatter that made up the bulk of the log
# while keeping the warnings that report silent failures — escalation reaching
# nobody, an automation rule that can never fire, a failed push, a backup alert
# with nowhere to go.
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wmt
DB_USERNAME=REPLACE_ME
DB_PASSWORD=REPLACE_ME

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=REPLACE_ME
REDIS_PORT=6379

# Outbound email is deliberately OFF: no mailer is configured, and MAIL_MAILER=log
# is not a way of being off -- it renders every message into laravel.log instead
# of sending it. Set this to true at the same time as configuring a real mailer.
MAIL_ENABLED=false
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=REPLACE_ME
MAIL_PASSWORD=REPLACE_ME
MAIL_FROM_ADDRESS=REPLACE_ME
MAIL_FROM_NAME="${APP_NAME}"

PUSHER_APP_ID=REPLACE_ME
PUSHER_APP_KEY=REPLACE_ME
PUSHER_APP_SECRET=REPLACE_ME
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=REPLACE_ME
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

VITE_PUSHER_APP_KEY=REPLACE_ME
VITE_PUSHER_HOST=wmt.bfcgroup.ph
VITE_PUSHER_PORT=443
VITE_PUSHER_SCHEME=https
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Firebase Cloud Messaging (for mobile push notifications)
# Place your service account JSON at storage/app/firebase-credentials.json
# Or set a custom path: FCM_CREDENTIALS=/path/to/credentials.json


# AI Platform: "openai" or "openrouter"
AI_PLATFORM=openrouter
OPENAI_API_KEY=REPLACE_ME
OPENAI_MODEL=gpt-4o
OPENROUTER_API_KEY=REPLACE_ME
OPENROUTER_MODEL=openai/gpt-4o

AI_MODEL_CHAT=nvidia/nemotron-3-ultra-550b-a55b:free   # cheap default (or leave blank)
AI_MODEL_VISION=openai/gpt-4o                           # needed for image/PDF reading
AI_MODEL_REASONING=anthropic/claude-3.5-sonnet          # optional, deep analysis
AI_MODEL_DOCUMENTS=                                      # optional; blank = use chat model

FCM_PROJECT_ID=REPLACE_ME

# Firebase Web SDK (for browser push notifications)
VITE_FIREBASE_API_KEY=REPLACE_ME
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_ME
VITE_FIREBASE_PROJECT_ID=REPLACE_ME
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
VITE_FIREBASE_APP_ID=REPLACE_ME
VITE_FIREBASE_VAPID_KEY=REPLACE_ME


TURNSTILE_SITE_KEY=REPLACE_ME
TURNSTILE_SECRET_KEY=REPLACE_ME
VITE_TURNSTILE_SITE_KEY=REPLACE_ME

# Inbound webhook API key (x-api-key header). Unset = endpoint disabled.
WEBHOOK_API_KEY=REPLACE_ME

# Database Backup
# BACKUP_ARCHIVE_PASSWORD=   # empty string enables encryption with no password; leave unset to disable
BACKUP_NOTIFICATION_EMAIL=REPLACE_ME

# Google Drive (for off-site backups)
GOOGLE_DRIVE_CLIENT_ID=REPLACE_ME
GOOGLE_DRIVE_CLIENT_SECRET=REPLACE_ME
GOOGLE_DRIVE_REFRESH_TOKEN=REPLACE_ME
GOOGLE_DRIVE_FOLDER_ID=REPLACE_ME
GOOGLE_DRIVE_FOLDER_PATH=Backup/WMT
