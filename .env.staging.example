APP_NAME=WMT
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://wmt-dev.bfcgroup.ph

# The public hostname the browser uses — feeds the Vite build (websocket host)
# and must match APP_URL's host. Change it and you must rebuild, not restart.
PUBLIC_HOSTNAME=wmt-dev.bfcgroup.ph

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Rotation. `single` writes one file that grows forever and ages nothing out —
# it is how laravel.log reached 24k lines holding a month of rendered email.
# `daily` writes laravel-YYYY-MM-DD.log and prunes beyond LOG_DAILY_DAYS.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# --- database (the mysql service in this compose) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=wmt
DB_USERNAME=wmt
DB_PASSWORD=REPLACE_ME
# Only used to create the container and for healthchecks.
DB_ROOT_PASSWORD=REPLACE_ME

# --- redis (the redis service) ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- websockets: soketi (Pusher protocol) ---
# Server side reaches soketi over the compose network; the browser reaches it
# over the tunnel (nginx proxies /app/). VITE_PUSHER_HOST is built from
# PUBLIC_HOSTNAME above.
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=wmt-staging
PUSHER_APP_KEY=REPLACE_ME_KEY
PUSHER_APP_SECRET=REPLACE_ME_SECRET
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

# --- mail: staging must not send real mail ---
# Outbound email off by default on staging: MAIL_MAILER=log is not a way of being
# off, it renders every message into laravel.log instead of sending it.
MAIL_ENABLED=false
MAIL_MAILER=log
MAIL_FROM_ADDRESS="staging@wmt-dev.bfcgroup.ph"
MAIL_FROM_NAME="${APP_NAME} (staging)"

FILESYSTEM_DISK=local

# --- turn off third-party gates that would block a test login ---
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- off by default on staging; fill in only if you are testing them ---
FCM_PROJECT_ID=
AI_PLATFORM=openai
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Off-site backups are a production concern; backups aren't scheduled on staging.
# The address still has to be valid, though — spatie/laravel-backup validates it
# at boot, and mail is `log` here so nothing is actually sent.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=staging@wmt-dev.bfcgroup.ph
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Leave blank to disable the inbound notify webhook on staging.
WEBHOOK_API_KEY=

# The loopback port nginx binds on the host; the cloudflared ingress rule for
# wmt-dev.bfcgroup.ph points here. 9081 avoids snipe (8000) / purchasing (9080).
HTTP_PORT=9081
