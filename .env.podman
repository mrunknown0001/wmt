# Local Podman stack — see docker-compose.podman.yml.
# Injected as environment variables via env_file, NOT mounted as a file: a
# rootless container cannot reliably read a host-owned .env through a bind mount.

APP_NAME=WMT
APP_ENV=local
APP_KEY=base64:Aw4PyMcWqt2DFytPQl1Skdd24c3mCDVoJa/xWk5mP/M=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=wmt
DB_USERNAME=wmt
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=wmt
PUSHER_APP_KEY=wmtkey
PUSHER_APP_SECRET=wmtsecret
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

MAIL_MAILER=log
MAIL_FROM_ADDRESS="wmt@example.com"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

# Public forms are unusable locally with Turnstile on and no keys.
TURNSTILE_ENABLED=false

# spatie/laravel-backup validates this eagerly; an empty value breaks
# config:cache at container start.
BACKUP_NOTIFICATION_EMAIL=admin@wmt.com
